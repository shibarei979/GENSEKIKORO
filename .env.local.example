# ============================================================
# 原石航路 環境変数
# このファイルを .env.local にコピーして実際の値を入力してください
# .env.local は .gitignore に含まれており Git にコミットされません
#
# コード内では process.env を直接参照せず、
# src/config/env.client.ts / env.server.ts 経由で利用します。
# ============================================================

# --- Supabase（必須） ダッシュボード → Settings → API から取得 ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- サイトURL（任意 / 未設定時は本番URLにフォールバック） ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 管理系機能で利用（任意） ---
SUPABASE_SERVICE_ROLE_KEY=

# --- AIレビュー・独自性チェック（任意） ---
ANTHROPIC_API_KEY=

# --- Vercel Cron 認証（任意） ---
CRON_SECRET=
